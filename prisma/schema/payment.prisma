model Payment {
  id String @unique @default(ulid())

  status                PaymentStatus @default(UNPAID)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("BDT")
  paymentGateway        String        @default("bkash")
  // from create payment 
  merchantInvoiceNumber String        @unique // appointment id 

  //from execure payment
  bkashPaymentId String? @unique
  bkashtrxId     String?
  payerReference String? //User Email
  paidAt         String?

  // Store Whole response 
  gatewayResponse Json?

  // from refund payment 
  refundTrxId  String?
  refundAmount String?
  refundedAt   String?
  refundReason String?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}
