{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!src/generated",
			"!src/app/templates"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style":{
				"noNonNullAssertion":"info",
				"useNodejsImportProtocol": "info"
			},
			"correctness" :{
				"noUnusedFunctionParameters":"info"
			},
			"suspicious":{
				"noExplicitAny":"warn"
			},
			"complexity":{
				"noCommaOperator":"warn"
			}
		},
			"includes": [
			"**",
			"!src/generated",
			"!src/app/templates"]
	
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
